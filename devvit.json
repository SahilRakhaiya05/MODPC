{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "mody-os",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "http": {
      "enable": true,
      "domains": ["api.groq.com"]
    },
    "redis": true,
    "reddit": {
      "enable": true,
      "scope": "moderator"
    }
  },
  "menu": {
    "items": [
      {
        "label": "Open ModDesk OS",
        "description": "Launch the private moderator operations desk",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Open in ModDesk",
        "description": "Open this item inside the ModDesk moderation workspace",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/open"
      },
      {
        "label": "Open in ModDesk",
        "description": "Open this comment inside the ModDesk moderation workspace",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/open"
      },
      {
        "label": "Escalate to Consensus",
        "description": "Prepare a consensus case for this moderation target",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/escalate"
      },
      {
        "label": "Escalate to Consensus",
        "description": "Prepare a consensus case for this comment",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/escalate"
      },
      {
        "label": "Draft Safe Response",
        "description": "Open Sentinel and prepare a safe draft response",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/draft"
      },
      {
        "label": "Draft Safe Response",
        "description": "Open Sentinel and prepare a safe draft response for this comment",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/draft"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostReport": "/internal/triggers/on-post-report",
    "onCommentReport": "/internal/triggers/on-comment-report",
    "onModAction": "/internal/triggers/on-mod-action",
    "onModMail": "/internal/triggers/on-mod-mail"
  },
  "scheduler": {
    "tasks": {
      "moddesk-refresh-live-stats": {
        "endpoint": "/internal/scheduler/refresh-live-stats",
        "cron": "*/5 * * * *"
      },
      "moddesk-queued-action": {
        "endpoint": "/internal/scheduler/queued-action"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "mody_os_dev"
  }
}
